PORT=3000

# Supabase — Settings → API in your Supabase project dashboard
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to be visible in the browser
# (the server injects them into index.html/dashboard.html at request time).
# SUPABASE_SERVICE_ROLE_KEY must NEVER leave the server or be committed —
# it bypasses all Row Level Security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Email config (use Gmail App Password or any SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Your admin email (where order notifications go)
ADMIN_EMAIL=your@gmail.com

# Admin dashboard password
ADMIN_PASSWORD=changeme123

# Your WhatsApp number (digits only, with country code)
WHATSAPP_NUMBER=254700000000

# Your site URL (for CORS)
SITE_URL=https://your-site.netlify.app
